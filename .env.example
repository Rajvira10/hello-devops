# Copy to .env (git-ignored) and change the values:  cp .env.example .env

# Enables the observability stack in `docker compose up`.
COMPOSE_PROFILES=monitoring

# Grafana admin login — REQUIRED, no defaults are baked into the compose file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please

# App
APP_VERSION=0.1.0-local
APP_ENV=local
LOG_LEVEL=info
# Enables GET /debug/error (send header X-Admin-Token) for demoing error alerts.
# Leave empty to disable the endpoint.
ADMIN_TOKEN=

# Optional: Discord webhook for Alertmanager notifications.
DISCORD_WEBHOOK_URL=

# Interface for published ports (127.0.0.1 = this machine only).
BIND_ADDR=127.0.0.1
