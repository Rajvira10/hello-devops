#!/bin/bash
# hello-devops-deploy — installed by Terraform user data; invoked by CI via SSM.
#
#   hello-devops-deploy <tag>      deploy <tag>; auto-rollback if unhealthy
#   hello-devops-deploy --rollback redeploy the previously running tag
#   hello-devops-deploy --status   print current/previous tags
#
# Exit codes: 0 deployed and healthy, 1 failed (previous version restored),
# 2 usage error.
set -euo pipefail

REGION="${region}"
REGISTRY="${registry}"
REPOSITORY="${repository_url}"
LOG_GROUP="${log_group}"
APP_ENV="${environment}"
LOG_LEVEL="${log_level}"
MEMORY_MB="${memory_mb}"
NAME="${container_name}"
PARAM_PATH="${ssm_param_path}"

STATE_DIR=/var/lib/hello-devops
SECRETS_DIR=/run/hello-devops
HEALTH_URL=http://127.0.0.1:80/health
HEALTH_TIMEOUT=60

log() { echo "[deploy $(date -u +%H:%M:%S)] $*"; }

mkdir -p "$STATE_DIR"
current_tag()  { cat "$STATE_DIR/current_tag" 2>/dev/null || true; }
previous_tag() { cat "$STATE_DIR/previous_tag" 2>/dev/null || true; }

case "$${1:-}" in
  ""|-h|--help) sed -n '2,9p' "$0"; exit 2 ;;
  --status) echo "current=$(current_tag) previous=$(previous_tag)"; exit 0 ;;
  --rollback)
    TAG=$(previous_tag)
    [[ -n "$TAG" ]] || { log "no previous tag recorded; cannot roll back"; exit 1; }
    log "rolling back to $TAG" ;;
  *) TAG=$1 ;;
esac
[[ "$TAG" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]] || { log "invalid tag: $TAG"; exit 2; }
IMAGE="$REPOSITORY:$TAG"

wait_healthy() {
  local deadline=$((SECONDS + HEALTH_TIMEOUT))
  while ((SECONDS < deadline)); do
    if curl -fsS -m 2 "$HEALTH_URL" >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  return 1
}

write_secrets() {
  install -d -m 0700 "$SECRETS_DIR"
  local token
  token=$(aws ssm get-parameter --region "$REGION" --with-decryption \
            --name "$PARAM_PATH/ADMIN_TOKEN" --query Parameter.Value --output text 2>/dev/null || true)
  [[ "$token" == "CHANGE_ME" ]] && token=""
  umask 077
  printf 'ADMIN_TOKEN=%s\n' "$token" > "$SECRETS_DIR/secrets.env"
}

run_container() {   # run_container <container-name> <image>
  docker run -d --name "$1" \
    --restart unless-stopped \
    -p 80:8080 \
    --read-only --cap-drop ALL --security-opt no-new-privileges \
    --memory "$${MEMORY_MB}m" --cpus 0.8 --pids-limit 128 \
    --stop-timeout 20 \
    -e APP_ENV="$APP_ENV" -e LOG_LEVEL="$LOG_LEVEL" -e SHUTDOWN_DELAY=2s \
    --env-file "$SECRETS_DIR/secrets.env" \
    --log-driver awslogs \
    --log-opt awslogs-region="$REGION" \
    --log-opt awslogs-group="$LOG_GROUP" \
    --log-opt awslogs-stream="$APP_ENV/$TAG/$(date -u +%Y%m%dT%H%M%S)" \
    --label "org.opencontainers.image.version=$TAG" \
    "$2" >/dev/null
}

log "logging in to $REGISTRY"
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$REGISTRY" >/dev/null

log "pulling $IMAGE"
docker pull --quiet "$IMAGE" >/dev/null
write_secrets

OLD_TAG=$(current_tag)
# Keep the old container (stopped, renamed) so restoring it takes seconds.
docker rm -f "$NAME-previous" >/dev/null 2>&1 || true
if docker inspect "$NAME" >/dev/null 2>&1; then
  log "stopping current container ($${OLD_TAG:-unknown})"
  docker stop --time 20 "$NAME" >/dev/null
  docker rename "$NAME" "$NAME-previous"
fi

log "starting $IMAGE"
if run_container "$NAME" "$IMAGE" && wait_healthy; then
  docker rm -f "$NAME-previous" >/dev/null 2>&1 || true
  if [[ -n "$OLD_TAG" && "$OLD_TAG" != "$TAG" ]]; then echo "$OLD_TAG" > "$STATE_DIR/previous_tag"; fi
  echo "$TAG" > "$STATE_DIR/current_tag"
  docker image prune -f --filter "until=168h" >/dev/null 2>&1 || true
  log "SUCCESS: $TAG is healthy"
  exit 0
fi

log "FAILED: $TAG did not become healthy within $${HEALTH_TIMEOUT}s"
docker logs --tail 50 "$NAME" 2>&1 | sed 's/^/  | /' || true
docker rm -f "$NAME" >/dev/null 2>&1 || true
if docker inspect "$NAME-previous" >/dev/null 2>&1; then
  docker rename "$NAME-previous" "$NAME"
  docker start "$NAME" >/dev/null
  if wait_healthy; then log "restored previous version $${OLD_TAG:-unknown}"; else log "WARNING: previous version is also unhealthy"; fi
fi
exit 1
