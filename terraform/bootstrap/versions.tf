terraform {
  required_version = ">= 1.10.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.72"
    }
  }

  # Bootstrap creates the state bucket itself, so it starts with local state.
  # After the first apply you can migrate it into the bucket it created:
  #   terraform init -migrate-state -backend-config=...
}

provider "aws" {
  region = var.region

  default_tags {
    tags = {
      Project   = var.project
      ManagedBy = "terraform"
      Stack     = "bootstrap"
    }
  }
}
