      "type": "timeseries",
      "title": "Network traffic (host interfaces)",
      "description": "Receive above zero, transmit below. Source: cAdvisor root cgroup (id=\"/\"), because node-exporter runs in its own network namespace on the internal Docker network and would only see its own eth0 \u2014 see README.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (interface) (rate(container_network_receive_bytes_total{id=\"/\", interface!~\"lo|veth.*|br-.*|docker.*\"}[$__rate_interval]))",
